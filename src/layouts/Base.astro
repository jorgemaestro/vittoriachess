---
// Plantilla común de todas las páginas: cabecera, tokens, fuentes y estilos base.
import '../styles/tokens.css';
import '../styles/fuentes.css';
import Cursor from '../components/Cursor.astro';

interface Props {
	title?: string;
	lang?: string;
	noindex?: boolean;
	/** "oscuro": la página entera en tono oscuro (ver tokens.css). */
	tono?: 'claro' | 'oscuro';
}

const { title = 'Vittoria Chess', lang = 'es', noindex = false, tono = 'claro' } = Astro.props;
---

<html lang={lang} data-tono={tono === 'oscuro' ? 'oscuro' : undefined}>
	<head>
		<meta charset="utf-8" />
		<!-- Marca que hay JavaScript: sin ella, los componentes muestran su versión sin JS. -->
		<script is:inline>document.documentElement.classList.add('js');</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<Cursor />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		min-height: 100%;
		background: var(--color-fondo);
		color: var(--color-tinta);
		font-family: var(--fuente);
		font-weight: var(--peso-medio);
		-webkit-font-smoothing: antialiased;
	}

	::selection {
		background: var(--color-seleccion);
	}

	/* Texto solo para lectores de pantalla (p. ej. el título de una página sin título visible). */
	.solo-lectores {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
</style>
