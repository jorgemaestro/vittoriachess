---
// Plantilla común de todas las páginas: cabecera, tokens, fuentes y estilos base.
// La cabecera lleva lo que leen Google y las redes (ver docs/seo.md): título, descripción,
// dirección canónica, la misma página en el otro idioma, imagen para compartir y datos
// estructurados.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fuentes.css';
import Cursor from '../components/Cursor.astro';
import { sinBarraFinal, usar } from '../i18n';

interface Props {
	title?: string;
	/** Descripción para Google y redes. Sin ella se usa la general de la web. */
	description?: string;
	/** Foto para compartir: carpeta y nombre sin extensión dentro de src/assets, p. ej. "piezas/rey". */
	imagen?: string;
	/** Datos estructurados (schema.org) de la página. */
	datos?: object[];
	noindex?: boolean;
	/** "oscuro": la página entera en tono oscuro (ver tokens.css). */
	tono?: 'claro' | 'oscuro';
}

const { idioma, t, enIdioma, conEquivalente } = usar(Astro);
const {
	title = t.seo.inicio.titulo,
	description = t.seo.inicio.descripcion,
	imagen = t.seo.imagen,
	datos = [],
	noindex = false,
	tono = 'claro',
} = Astro.props;

const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
const canonica = absoluta(sinBarraFinal(Astro.url.pathname));

// Imagen para compartir: 1200 × 630, recortada de la foto indicada (si existe).
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
);
// Si la foto pedida aún no está en su carpeta, se usa la general de la web.
const buscar = (nombre: string) =>
	Object.keys(fotos).find((r) => r.replace(/\.[^.]+$/, '') === `/src/assets/${nombre}`);
const rutaFoto = buscar(imagen) ?? buscar(t.seo.imagen);
const paraCompartir = rutaFoto
	? await getImage({
			src: (await fotos[rutaFoto]()).default,
			width: 1200,
			height: 630,
			fit: 'cover',
			format: 'jpg',
		})
	: undefined;
---

<html lang={idioma} data-tono={tono === 'oscuro' ? 'oscuro' : undefined}>
	<head>
		<meta charset="utf-8" />
		<!-- Marca que hay JavaScript: sin ella, los componentes muestran su versión sin JS. -->
		<script is:inline>document.documentElement.classList.add('js');</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			!noindex && (
				<>
					<link rel="canonical" href={canonica} />
					{conEquivalente && (
						<>
							<link rel="alternate" hreflang="es" href={absoluta(enIdioma.es)} />
							<link rel="alternate" hreflang="en" href={absoluta(enIdioma.en)} />
							<link rel="alternate" hreflang="x-default" href={absoluta(enIdioma.en)} />
						</>
					)}
					<meta property="og:site_name" content="Vittoria Chess" />
					<meta property="og:type" content="website" />
					<meta property="og:locale" content={idioma === 'en' ? 'en_GB' : 'es_ES'} />
					<meta property="og:url" content={canonica} />
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					{paraCompartir && (
						<>
							<meta property="og:image" content={absoluta(paraCompartir.src)} />
							<meta property="og:image:width" content="1200" />
							<meta property="og:image:height" content="630" />
						</>
					)}
					<meta name="twitter:card" content={paraCompartir ? 'summary_large_image' : 'summary'} />
					{datos.map((dato) => (
						<script type="application/ld+json" is:inline set:html={JSON.stringify(dato)} />
					))}
				</>
			)
		}
	</head>
	<body>
		<slot />
		<Cursor />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		min-height: 100%;
		background: var(--color-fondo);
		color: var(--color-tinta);
		font-family: var(--fuente);
		font-weight: var(--peso-medio);
		-webkit-font-smoothing: antialiased;
	}

	::selection {
		background: var(--color-seleccion);
	}

	/* Texto solo para lectores de pantalla (p. ej. el título de una página sin título visible). */
	.solo-lectores {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
</style>
