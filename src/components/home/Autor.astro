---
// Home · Acceso a Autor — ver docs/definicion.md (Páginas: Home, punto 6).
// Sin título. Foto 512 × 683 a 96 px del borde; a la derecha (columna de 744 px) la firma
// y SABER MÁS (lleva a /autor). Móvil: foto a todo el
// ancho y texto debajo. Foto: src/assets/autor/home (caja gris mientras no esté).
import EnlaceGuia from '../EnlaceGuia.astro';
import Foto from '../Foto.astro';
import { usar } from '../../i18n';

const { t, r } = usar(Astro);
---

<section class="autor" aria-label={t.autor.titulo}>
	<div class="cuerpo">
		<div class="foto">
			<Foto
				nombre="autor/home"
				alt={`[${t.pendiente}: ${t.home.autorFoto}]`}
				proporcion={512 / 683}
				sizes="(max-width: 809px) calc(100vw - 40px), 35.556vw"
			/>
		</div>
		<div class="texto">
			<p class="firma">{t.home.autorFirma}</p>
			<p class="leer">
				<EnlaceGuia href={r.autor} lado="derecha">{t.home.saberMas}</EnlaceGuia>
			</p>
		</div>
	</div>
</section>

<style>
	.autor {
		margin-top: var(--aire);
	}

	p {
		margin: 0;
	}

	.cuerpo {
		display: flex;
		align-items: flex-start;
	}

	/* 512 × 683 a 96 px del borde. */
	.foto {
		flex: none;
		width: 35.556vw;
		margin-left: 6.667vw;
	}

	/* Columna de 744 px: 744 − (96 + 512) = 136 px de separación. Máx. 480 px. */
	.texto {
		margin-left: 9.444vw;
		max-width: 33.333vw;
	}

	.firma {
		color: var(--color-secundario);
		font-size: var(--pie-foto);
		line-height: var(--pie-foto-alto);
	}

	.leer {
		margin-top: 24px;
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
	}

	@media (max-width: 809px) {
		.cuerpo {
			flex-direction: column;
			padding: 0 var(--margen);
		}

		.foto {
			width: 100%;
			margin-left: 0;
		}

		.texto {
			margin: 24px 0 0;
			max-width: none;
		}
	}
</style>
