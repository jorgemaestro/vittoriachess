---
// Home · Vídeo — ver docs/definicion.md (Páginas: Home, puntos 2 y 5).
// Se usa dos veces: el vídeo principal y el de Obras.
// Pantalla completa, sin texto ni sonido, en bucle y automático; versión vertical para
// móvil y póster mientras carga. La barra va en claro encima (data-nav-claro).
// Sin vídeo todavía: bloque provisional oscuro con marcador [PENDIENTE].
interface Props {
	/** Nombre para lectores de pantalla y para el marcador provisional. */
	nombre: string;
	/** Direcciones del vídeo (Cloudflare R2, Fase 6). Sin ellas, bloque provisional. */
	horizontal?: string;
	vertical?: string;
	poster?: string;
}

const { nombre, horizontal, vertical, poster } = Astro.props;
---

<section class="video" data-nav-claro aria-label={nombre}>
	{
		horizontal ? (
			<video autoplay muted loop playsinline preload="metadata" poster={poster} data-video>
				{vertical && <source media="(max-width: 809px)" src={vertical} type="video/mp4" />}
				<source src={horizontal} type="video/mp4" />
			</video>
		) : (
			<p class="pendiente">[PENDIENTE: {nombre.toUpperCase()}]</p>
		)
	}
</section>

<script>
	// Con movimiento reducido el vídeo no arranca solo: se queda el póster.
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => {
			video.removeAttribute('autoplay');
			video.pause();
		});
	}
</script>

<style>
	.video {
		position: relative;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
		background: var(--color-provisional-oscuro);
		color: var(--color-claro);
	}

	video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pendiente {
		position: absolute;
		left: var(--margen);
		bottom: var(--margen);
		margin: 0;
		font-size: var(--pie-foto);
		line-height: var(--pie-foto-alto);
		opacity: 0.5;
	}
</style>
