---
// Home · Manifiesto — ver docs/definicion.md (Páginas: Home, punto 3).
// Tres líneas 10 vw bajo el vídeo, a la izquierda. A la derecha, un cuadro de 434 × 434 px
// (vídeo o foto cuadrada) alineado por arriba con el manifiesto, y debajo VER PIEZAS,
// alineado con el lado derecho del cuadro (en móvil, todo en una columna). Al entrar
// en pantalla, cada línea sube desde una máscara. El texto solo se esconde si el script de
// la animación arranca: sin JavaScript o si falla, se ve directamente.
import EnlaceGuia from '../EnlaceGuia.astro';
import Foto from '../Foto.astro';
import { videoPiezas } from '../../data/videos';
import { usar } from '../../i18n';

const { t, r } = usar(Astro);
const lineas = t.home.manifiesto;

// El cuadro: el vídeo cuadrado si existe; si no, la foto home/piezas; y mientras no haya
// ninguna de las dos, provisionalmente, la foto del rey recortada a cuadrado.
const { video, poster } = videoPiezas();
const hayFoto =
	Object.keys(import.meta.glob('/src/assets/home/piezas.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}'))
		.length > 0;
const foto = hayFoto ? 'home/piezas' : 'piezas/rey';
---

<section class="manifiesto">
	<p class="texto" data-manifiesto>
		{
			lineas.map((linea) => (
				<span class="linea">
					<span class="interior">{linea}</span>
				</span>
			))
		}
	</p>
	<div class="lado">
		<!-- El cuadro también lleva a Piezas, solo con ratón o dedo: para teclado y lectores
		     de pantalla el enlace es VER PIEZAS (así no se repite). -->
		<a class="cuadro" href={r.piezas} tabindex="-1" aria-hidden="true">
			{
				video ? (
					<video autoplay muted loop playsinline preload="metadata" poster={poster} data-video>
						<source src={video} type="video/mp4" />
					</video>
				) : (
					<Foto
						nombre={foto}
						alt=""
						proporcion={1}
						sizes="(max-width: 809px) calc(100vw - 40px), 30.139vw"
					/>
				)
			}
		</a>
		<p class="ver"><EnlaceGuia href={r.piezas} lado="derecha">{t.home.verPiezas}</EnlaceGuia></p>
	</div>
</section>

<script>
	const texto = document.querySelector<HTMLElement>('[data-manifiesto]');
	const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (texto && !sinMovimiento && 'IntersectionObserver' in window) {
		texto.classList.add('preparado');
		const observador = new IntersectionObserver(
			([entrada]) => {
				if (entrada.isIntersecting) {
					texto.classList.add('visible');
					observador.disconnect();
				}
			},
			{ rootMargin: '0px 0px -15% 0px' },
		);
		observador.observe(texto);
	}
</script>

<style>
	/* El cuadro y el manifiesto empiezan a la misma altura. VER PIEZAS cuelga bajo el cuadro,
	   fuera del flujo; el hueco de debajo lo reserva la sección. */
	.manifiesto {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding: 10vw calc(var(--margen) + 8.194vw) calc(24px + var(--nav-central-alto)) var(--margen);
	}

	/* 434 × 434 px (30,139 vw), de 868 a 1302 px: termina a 138 px del borde, como VER OBRAS. */
	.lado {
		position: relative;
		flex: none;
		width: 30.139vw;
		/* Baja lo que mide el aire sobre las mayúsculas de la primera línea (0,18 del tamaño
		   de letra con Inter Tight; revisar al cambiar de fuente): el borde de arriba del cuadro
		   queda a la altura exacta de las letras. */
		margin-top: calc(var(--manifiesto) * 0.18);
	}

	.cuadro {
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		background: var(--color-provisional);
	}

	.cuadro video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.texto {
		margin: 0;
		font-weight: var(--peso-regular);
		font-size: var(--manifiesto);
		line-height: var(--manifiesto-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	/* Máscara: deja aire abajo para no cortar las letras que bajan (g, p). */
	.linea {
		display: block;
		overflow: hidden;
		padding-bottom: 0.15em;
		margin-bottom: -0.15em;
	}

	.interior {
		display: block;
		transition: transform 1.2s var(--ease);
	}

	.preparado .interior {
		transform: translateY(110%);
	}

	.preparado.visible .interior {
		transform: none;
	}

	.visible .linea:nth-child(2) .interior {
		transition-delay: 80ms;
	}

	.visible .linea:nth-child(3) .interior {
		transition-delay: 160ms;
	}

	/* 24 px bajo el cuadro, alineado con su lado derecho. */
	.ver {
		position: absolute;
		top: calc(100% + 24px);
		right: 0;
		margin: 0;
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
		white-space: nowrap;
	}

	@media (max-width: 809px) {
		.manifiesto {
			flex-direction: column;
			align-items: stretch;
			padding: 10vw var(--margen) 0;
		}

		.lado {
			width: auto;
			margin-top: 40px;
		}

		.ver {
			position: static;
			margin: 24px 0 0;
		}
	}
</style>
