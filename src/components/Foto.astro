---
// Foto por nombre — ver docs/definicion.md ("Fotos y vídeos: nombres de archivo").
// Busca src/assets/<nombre>.{jpg,jpeg,png,webp}. Si existe, la muestra optimizada y
// recortada a la proporción del hueco; si no, caja gris provisional con esa proporción.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** Carpeta y nombre sin extensión, p. ej. "obras/obra-01". */
	nombre: string;
	alt: string;
	/** Proporción del hueco: ancho / alto, p. ej. 512 / 696. */
	proporcion: number;
	/** Ancho que ocupa en pantalla, para elegir la versión ligera (atributo sizes). */
	sizes: string;
	class?: string;
}

const { nombre, alt, proporcion, sizes, class: clase } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
);
const ruta = Object.keys(fotos).find((r) => r.replace(/\.[^.]+$/, '') === `/src/assets/${nombre}`);
const foto = ruta ? (await fotos[ruta]()).default : undefined;
---

{
	foto ? (
		<Image
			src={foto}
			alt={alt}
			widths={[480, 800, 1200, 1600]}
			sizes={sizes}
			class:list={['foto', clase]}
			style={`aspect-ratio: ${proporcion}`}
		/>
	) : (
		<div
			class:list={['foto', 'provisional', clase]}
			style={`aspect-ratio: ${proporcion}`}
			role="img"
			aria-label={`[PENDIENTE: ${nombre}] ${alt}`}
		/>
	)
}

<style>
	.foto {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.provisional {
		background: var(--color-provisional);
	}
</style>
