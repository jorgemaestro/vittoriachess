---
// Foto por nombre — ver docs/definicion.md ("Fotos y vídeos: nombres de archivo").
// Busca src/assets/<nombre>.{jpg,jpeg,png,webp}. Si existe, la muestra optimizada y
// recortada a la proporción del hueco (o a su proporción natural, con `natural`); si no,
// caja gris provisional con la proporción indicada.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { usar } from '../i18n';

interface Props {
	/** Carpeta y nombre sin extensión, p. ej. "obras/obra-01". */
	nombre: string;
	alt: string;
	/** Proporción del hueco: ancho / alto, p. ej. 512 / 696. */
	proporcion: number;
	/** Ancho que ocupa en pantalla, para elegir la versión ligera (atributo sizes). */
	sizes: string;
	/** true: la foto se muestra a su proporción real, sin recortar (la caja gris usa `proporcion`). */
	natural?: boolean;
	class?: string;
}

const { nombre, alt, proporcion, sizes, natural = false, class: clase } = Astro.props;
const { t } = usar(Astro);

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
);
const ruta = Object.keys(fotos).find((r) => r.replace(/\.[^.]+$/, '') === `/src/assets/${nombre}`);
const foto = ruta ? (await fotos[ruta]()).default : undefined;

// Recortada a la proporción del hueco: Astro genera las versiones ya recortadas (si no, una
// foto mucho más ancha que su hueco se escalaba por la altura y se veía pixelada). Solo se
// piden anchos que el original permite sin ampliar.
const anchoRecorte = foto
	? Math.floor(Math.min(foto.width, foto.height * proporcion))
	: 0;
const anchos = [480, 800, 1200, 1600].filter((w) => w <= anchoRecorte);
const recorte =
	foto && !natural
		? {
				widths: anchos.length ? anchos : [anchoRecorte],
				width: Math.min(1600, anchoRecorte),
				height: Math.round(Math.min(1600, anchoRecorte) / proporcion),
				fit: 'cover' as const,
			}
		: { widths: [480, 800, 1200, 1600] };
---

{
	foto ? (
		<Image
			src={foto}
			alt={alt}
			{...recorte}
			sizes={sizes}
			class:list={['foto', clase]}
			style={natural ? undefined : `aspect-ratio: ${proporcion}`}
		/>
	) : (
		<div
			class:list={['foto', 'provisional', clase]}
			style={`aspect-ratio: ${proporcion}`}
			role="img"
			aria-label={`[${t.pendiente}: ${nombre}] ${alt}`}
		/>
	)
}

<style>
	.foto {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.provisional {
		background: var(--color-provisional);
	}
</style>
