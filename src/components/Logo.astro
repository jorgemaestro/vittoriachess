---
// Logotipo provisional — ver docs/definicion.md (Componentes: Logotipo).
// Texto en Cinzel hasta tener el SVG del estuche, que mantendrá la misma altura.
// Siempre con la firma debajo: BY JORGE MAESTRO (estilo pie de foto).
import { usar } from '../i18n';

interface Props {
	/** true: el logotipo enlaza a la home del idioma de la página. */
	enlace?: boolean;
	carga?: boolean;
}

const { enlace = false, carga = false } = Astro.props;
const { r } = usar(Astro);
const Etiqueta = enlace ? 'a' : 'span';
const href = enlace ? r.inicio : undefined;
---

<Etiqueta href={href} class:list={['logo', { carga }]}>
	<span class="nombre">Vittoria Chess</span>
	<span class="firma">BY JORGE MAESTRO</span>
</Etiqueta>

<style>
	.logo {
		display: block;
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
	}

	.nombre {
		display: block;
		font-family: var(--fuente-logo);
		font-weight: var(--peso-medio);
		font-size: var(--logo);
		line-height: 1;
		letter-spacing: var(--logo-espaciado);
	}

	.firma {
		display: block;
		font-family: var(--fuente);
		font-weight: var(--peso-medio);
		font-size: var(--pie-foto);
		line-height: var(--pie-foto-alto);
	}

	.carga {
		text-align: center;
	}

	.carga .nombre {
		font-size: var(--logo-carga);
	}
</style>
