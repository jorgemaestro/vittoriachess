---
// Barra de navegación — ver docs/definicion.md (Componentes: Barra de navegación).
// Fija, sin fondo. Se oculta al bajar y reaparece al subir. Tono claro mientras está
// sobre una zona marcada con data-nav-claro (el vídeo de la home); oscuro en el resto.
// Sin JavaScript queda siempre visible y en el tono inicial; en móvil muestra los enlaces
// en una fila pequeña en lugar del icono de menú.
import FilaNav from './FilaNav.astro';
import MenuIcono from './MenuIcono.astro';
import MenuMovil from './MenuMovil.astro';
import { enlaces, type Pagina } from './navegacion';

interface Props {
	actual?: Pagina;
	claro?: boolean;
}

const { actual, claro = false } = Astro.props;
---

<header class:list={['nav', { claro }]} data-nav>
	<FilaNav etiqueta="Principal" actual={actual} />
	<div class="menu">
		<MenuIcono controla="menu-movil" />
	</div>
</header>
<MenuMovil enlaces={enlaces} actual={actual} />

<script>
	const nav = document.querySelector<HTMLElement>('[data-nav]');

	if (nav) {
		const zonasClaras = document.querySelectorAll<HTMLElement>('[data-nav-claro]');
		let ultimaY = window.scrollY;
		let pendiente = false;

		const actualizar = () => {
			pendiente = false;
			const y = window.scrollY;

			// Se oculta al bajar (pasados 80 px) y reaparece al subir.
			if (y > ultimaY && y > 80) nav.classList.add('oculta');
			else if (y < ultimaY) nav.classList.remove('oculta');
			ultimaY = y;

			// Claro mientras el centro de la barra está sobre una zona oscura.
			const caja = nav.getBoundingClientRect();
			const centro = caja.top + caja.height / 2;
			const sobreOscuro = [...zonasClaras].some((zona) => {
				const r = zona.getBoundingClientRect();
				return r.top <= centro && r.bottom >= centro;
			});
			nav.classList.toggle('claro', sobreOscuro);
		};

		// Con el menú móvil abierto: tono oscuro y siempre visible.
		nav.addEventListener('menu:cambio', (e) => {
			const { abierto } = (e as CustomEvent<{ abierto: boolean }>).detail;
			nav.classList.toggle('menu-abierto', abierto);
			nav.classList.remove('oculta');
		});

		window.addEventListener(
			'scroll',
			() => {
				if (!pendiente) {
					pendiente = true;
					requestAnimationFrame(actualizar);
				}
			},
			{ passive: true },
		);
		actualizar();
	}
</script>

<style>
	.nav {
		position: fixed;
		z-index: 50;
		top: calc(var(--margen) + env(safe-area-inset-top, 0px));
		left: var(--margen);
		right: var(--margen);
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		color: var(--color-tinta);
		transition:
			transform 0.6s var(--ease),
			color 0.6s var(--ease);
	}

	.nav.claro {
		color: var(--color-claro);
	}

	.nav.menu-abierto {
		color: var(--color-tinta);
	}

	/* Se oculta al bajar; vuelve si se llega a ella con el teclado. */
	.nav.oculta:not(:focus-within) {
		/* Sube su propia altura más el margen superior: sale entera de la pantalla. */
		transform: translateY(calc(-100% - var(--margen) - env(safe-area-inset-top, 0px)));
	}

	/* El icono de menú solo existe por debajo de 810 px. */
	.menu {
		display: none;
	}

	@media (max-width: 809px) {
		/* Sin JavaScript: la fila de enlaces baja bajo el logotipo (ver FilaNav). */
		.nav {
			flex-wrap: wrap;
		}

		/* Con JavaScript: logotipo e icono de menú. El icono se centra con la línea del
		   logotipo (no con la firma) y su dibujo queda alineado con el margen derecho
		   (el área táctil sobresale). */
		:global(.js) .nav {
			align-items: flex-start;
		}

		:global(.js) .menu {
			display: block;
			margin: calc(var(--logo) / 2 - 20px) -8px 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav {
			transition: none;
		}
	}
</style>
