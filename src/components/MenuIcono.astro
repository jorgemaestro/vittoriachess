---
// Icono de menú — ver docs/definicion.md (Componentes: Icono de menú).
// Dos líneas de 24 px separadas 7 px en un área de 40 × 40 px. Al abrir se juntan en el
// centro y después giran ±45° hasta formar una cruz; al cerrar, el movimiento inverso.
// El estado vive en aria-expanded; el menú móvil escuchará el evento "menu:cambio".
interface Props {
	controla?: string;
}

const { controla } = Astro.props;
---

<button
	class="menu-icono"
	type="button"
	aria-expanded="false"
	aria-label="Abrir menú"
	aria-controls={controla}
	data-menu-icono
>
	<span class="raya"></span>
	<span class="raya"></span>
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-menu-icono]').forEach((boton) => {
		boton.addEventListener('click', () => {
			const abierto = boton.getAttribute('aria-expanded') !== 'true';
			boton.setAttribute('aria-expanded', String(abierto));
			boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
			boton.dispatchEvent(new CustomEvent('menu:cambio', { bubbles: true, detail: { abierto } }));
		});
	});
</script>

<style>
	.menu-icono {
		position: relative;
		display: block;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	.raya {
		position: absolute;
		top: 50%;
		left: 8px;
		width: 24px;
		/* Borde en lugar de relleno: grosor constante en cualquier pantalla (ver Enlace). */
		border-top: var(--linea) solid currentColor;
		margin-top: calc(var(--linea) / -2);
		/* Cerrar: primero deshace el giro, después se separan. */
		transition:
			rotate 0.35s var(--ease),
			translate 0.3s var(--ease) 0.25s;
	}

	.raya:first-child {
		translate: 0 -3.5px;
	}

	.raya:last-child {
		translate: 0 3.5px;
	}

	/* Abrir: primero se juntan en el centro, después giran hasta la cruz. */
	[aria-expanded='true'] .raya {
		translate: 0 0;
		transition:
			translate 0.3s var(--ease),
			rotate 0.45s var(--ease) 0.22s;
	}

	[aria-expanded='true'] .raya:first-child {
		rotate: 45deg;
	}

	[aria-expanded='true'] .raya:last-child {
		rotate: -45deg;
	}

	.menu-icono:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.raya,
		[aria-expanded='true'] .raya {
			transition: none;
		}
	}
</style>
