---
// Enlace con subrayado — ver docs/definicion.md (Componentes: Enlace).
// Al pasar el ratón el subrayado entra por la izquierda (1000 ms); al salir, sale por la
// derecha (1200 ms) y nunca vuelve por la izquierda. Activo: subrayado fijo, sin reacción.
// Sin href es un botón de envío (p. ej. ENVIAR del formulario), con el mismo aspecto.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href?: string;
	activo?: boolean;
}

const { href, activo = false, class: clase, ...resto } = Astro.props;
const Etiqueta = href ? 'a' : 'button';
---

<Etiqueta
	href={href}
	type={href ? undefined : 'submit'}
	class:list={['enlace', clase]}
	aria-current={activo ? 'page' : undefined}
	{...resto}
><slot /><span class="subrayado" aria-hidden="true"></span></Etiqueta>

<style>
	.enlace {
		position: relative;
		display: inline-block;
		color: inherit;
		text-decoration: none;
	}

	/* Como botón: sin aspecto de botón del navegador. */
	button.enlace {
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		/* Sin cursor propio: el de la web (cuadrado) lo pone Cursor; sin él, el normal. */
	}

	.subrayado {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		/* Más alto que el trazo (que va abajo del todo) para que el recorte nunca lo corte;
		   overflow: hidden además evita que el trazo en espera ensanche la página. */
		height: calc(var(--linea) + 2px);
		overflow: hidden;
		pointer-events: none;
	}

	/* Dos trazos: ::before entra por la izquierda; ::after sale por la derecha.
	   Se dibujan como borde (no como relleno) porque el navegador ajusta los bordes a
	   píxeles enteros: el grosor es el mismo en cualquier pantalla y escala. */
	.subrayado::before,
	.subrayado::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		border-top: var(--linea) solid currentColor;
	}

	.subrayado::before {
		transform: translateX(-101%);
	}

	.subrayado::after {
		transform: translateX(101%);
		transition: transform 1200ms var(--ease);
	}

	.enlace:hover .subrayado::before,
	.enlace:focus-visible .subrayado::before {
		transform: translateX(0);
		transition: transform 1000ms var(--ease);
	}

	.enlace:hover .subrayado::after,
	.enlace:focus-visible .subrayado::after {
		transform: translateX(0);
		opacity: 0;
		transition: none;
	}

	/* Activo: subrayado fijo, sin reacción */
	.enlace[aria-current] .subrayado::before {
		transform: translateX(0);
		transition: none;
	}

	.enlace[aria-current] .subrayado::after {
		display: none;
	}

	.enlace:focus-visible {
		outline: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.subrayado::before,
		.subrayado::after,
		.enlace:hover .subrayado::before,
		.enlace:focus-visible .subrayado::before {
			transition: none;
		}
	}
</style>
