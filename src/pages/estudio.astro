---
// Estudio — ver docs/definicion.md (Páginas: Estudio). Contiene la entrevista.
// Se lee de principio a fin haciendo scroll. Seis bloques alternos (foto a la izquierda en
// el primero): foto 512 × 683 a 96 px de su borde y, al otro lado, columna de texto de
// hasta 600 px. Preguntas en estilo Llamada, 40 / 48 px (suben desde una máscara al
// aparecer), y respuestas en regular, 24 / 32 px, entre comillas. 200 px entre
// bloques; el primero a 201 px. Después, la trayectoria y la llamada a contacto.
// Móvil: foto arriba y texto debajo; 120 px entre bloques.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Foto from '../components/Foto.astro';
import LlamadaContacto from '../components/LlamadaContacto.astro';
import Trayectoria from '../components/Trayectoria.astro';
import { bloques } from '../data/entrevista';
---

<Base title="Estudio — Vittoria Chess">
	<Nav actual="estudio" />
	<main>
		<h1 class="solo-lectores">Estudio</h1>
		<div class="entrevista" data-entrevista>
			{
				bloques.map((preguntas, i) => (
					<section class:list={['bloque', { derecha: i % 2 === 1 }]}>
						<div class="foto">
							<Foto
								nombre={`entrevista/bloque-${String(i + 1).padStart(2, '0')}`}
								alt={`[PENDIENTE: descripción de la foto ${i + 1} de la entrevista]`}
								proporcion={512 / 683}
								sizes="(max-width: 809px) calc(100vw - 40px), 35.556vw"
							/>
						</div>
						<div class="texto">
							{preguntas.map((p) => (
								<div class="qa">
									<h2 class="pregunta">
										<span class="mascara">
											<span class="contenido">
												<span class="marca" aria-hidden="true">P</span>
												{p.pregunta}
											</span>
										</span>
									</h2>
									<p class="respuesta">
										<span class="comilla abre" aria-hidden="true">“</span>{p.respuesta}<span
											class="comilla cierra"
											aria-hidden="true">”</span
										>
									</p>
								</div>
							))}
						</div>
					</section>
				))
			}
		</div>
		<Trayectoria />
		<LlamadaContacto />
	</main>
	<Footer />
</Base>

<script>
	// Las preguntas solo se esconden si este script arranca: sin JS se ven directamente.
	const entrevista = document.querySelector<HTMLElement>('[data-entrevista]');
	const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (entrevista && !sinMovimiento && 'IntersectionObserver' in window) {
		entrevista.classList.add('preparado');
		const observador = new IntersectionObserver(
			(entradas) => {
				entradas.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('visible');
						observador.unobserve(e.target);
					}
				});
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		entrevista
			.querySelectorAll('.pregunta .mascara, .respuesta')
			.forEach((el) => observador.observe(el));
	}
</script>

<style>
	.entrevista {
		display: flex;
		flex-direction: column;
		gap: 200px;
		padding: 201px 6.667vw 0; /* 96 px a cada lado */
	}

	/* Foto 512 px, texto hasta 600 px; entre ambos, 136 px (9,444 vw). */
	.bloque {
		display: flex;
		align-items: flex-start;
		gap: 9.444vw;
	}

	.bloque.derecha {
		flex-direction: row-reverse;
		justify-content: flex-end;
	}

	.foto {
		flex: none;
		width: 35.556vw;
	}

	.texto {
		width: 41.667vw;
		font-size: var(--respuesta);
		line-height: var(--respuesta-alto);
	}

	.qa + .qa {
		margin-top: 48px;
	}

	/* Preguntas en estilo Llamada (40 / 48 px, regular). */
	.pregunta {
		margin: 0;
		font-weight: var(--peso-regular);
		font-size: var(--llamada);
		line-height: var(--llamada-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	/* Cada pregunta sube desde su máscara al entrar en pantalla (como el manifiesto). */
	/* Recorta solo arriba y abajo (la animación es vertical): la P colgada no se corta. */
	.mascara {
		display: block;
		clip-path: inset(0 -100vw);
		padding-bottom: 0.15em;
		margin-bottom: -0.15em;
	}

	.contenido {
		display: block;
		transition: transform 1.2s var(--ease);
	}

	.preparado .contenido {
		transform: translateY(110%);
	}

	.preparado .visible .contenido {
		transform: none;
	}

	/* La P y la comilla de apertura cuelgan en el margen izquierdo: el texto queda
	   alineado en su columna. */
	.pregunta .contenido,
	.respuesta {
		position: relative;
	}

	.marca,
	.comilla {
		color: var(--color-secundario);
		font-weight: var(--peso-regular);
	}

	.marca,
	.abre {
		position: absolute;
	}

	.marca {
		right: calc(100% + 16px);
	}

	/* Puntuación colgada: la comilla queda fuera de la columna pero pegada al texto. */
	.abre {
		right: 100%;
	}

	/* Comillas animadas: la de apertura sube al aparecer la respuesta; la de cierre, 0,5 s
	   después. Solo se esconden si el script arranca. */
	.comilla {
		display: inline-block;
		transition:
			opacity 1.2s var(--ease),
			transform 1.2s var(--ease);
	}

	.cierra {
		transition-delay: 0.5s;
	}

	.preparado .respuesta .comilla {
		opacity: 0;
		transform: translateY(0.4em);
	}

	.preparado .respuesta.visible .comilla {
		opacity: 1;
		transform: none;
	}

	.respuesta {
		margin: 24px 0 0;
		font-weight: var(--peso-regular);
	}

	@media (max-width: 809px) {
		.entrevista {
			gap: 120px;
			padding: 120px var(--margen) 0;
		}

		.bloque,
		.bloque.derecha {
			flex-direction: column;
			gap: 24px;
		}

		.foto,
		.texto {
			width: 100%;
		}

		/* En móvil no hay margen: la P y la comilla de apertura van delante del texto. */
		.marca,
		.abre {
			position: static;
		}

		.marca {
			margin-right: 0.35em;
		}
	}
</style>
