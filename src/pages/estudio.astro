---
// Estudio — ver docs/definicion.md (Páginas: Estudio). Contiene la entrevista y la trayectoria.
// Entrevista en composición editorial sobre la retícula de la web (96 · 434 · 744 · 1044 ·
// 1344 px), con contraste de escala: pregunta en Llamada (o a tamaño manifiesto las más
// cortas), entradilla a 24 px y resto en Lectura (16 px). Un bloque distinto por pregunta
// y dos destacados con frases literales. Marca "(p)" pequeña delante de cada pregunta.
// Móvil: todo en una columna.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Foto from '../components/Foto.astro';
import LlamadaContacto from '../components/LlamadaContacto.astro';
import Trayectoria from '../components/Trayectoria.astro';
import { entrevista } from '../data/entrevista';

// Por bloque: proporción de su foto (null = sin foto), cuántas frases de la respuesta
// forman la entradilla y si la pregunta va a tamaño manifiesto.
const ajustes = [
	{ foto: 3 / 4, frases: 1, grande: false },
	{ foto: 5 / 4, frases: 1, grande: false },
	{ foto: null, frases: 1, grande: true },
	{ foto: 3 / 4, frases: 2, grande: false },
	{ foto: 5 / 4, frases: 1, grande: false },
	{ foto: 3 / 4, frases: 1, grande: false },
	{ foto: 5 / 4, frases: 1, grande: true },
];

// Las fotos se numeran solo entre los bloques que llevan foto (bloque-01 … bloque-06).
let numeroFoto = 0;
const bloques = entrevista.map((qa, i) => {
	const partes = qa.respuesta.split(/(?<=[.?!])\s+/);
	const { foto, frases, grande } = ajustes[i];
	return {
		pregunta: qa.pregunta,
		entradilla: partes.slice(0, frases).join(' '),
		resto: partes.slice(frases).join(' '),
		grande,
		foto,
		archivo: foto ? `entrevista/bloque-${String(++numeroFoto).padStart(2, '0')}` : undefined,
	};
});

// Frases literales de la entrevista, tras el bloque indicado (0 = primero).
const destacados: Record<number, string> = {
	1: 'Brancusi no esculpía el pájaro, sino el vuelo.',
	4: 'Una forma que se adapta al proceso acaba perdiendo su esencia.',
};
---

<Base title="Estudio — Vittoria Chess">
	<Nav actual="estudio" />
	<main>
		<h1 class="solo-lectores">Estudio</h1>
		<div class="entrevista" data-entrevista>
			{
				bloques.map((b, i) => (
					<>
						<section class:list={['bloque', `v${i + 1}`]}>
							<h2 class:list={['pregunta', { grande: b.grande }]}>
								<span class="mascara">
									<span class="contenido">
										<span class="marca" aria-hidden="true">(p)</span>
										{b.pregunta}
									</span>
								</span>
							</h2>
							{b.foto && (
								<div class="foto">
									<Foto
										nombre={b.archivo!}
										alt={`[PENDIENTE: descripción de la foto ${b.archivo}]`}
										proporcion={b.foto}
										sizes="(max-width: 809px) calc(100vw - 40px), 42vw"
									/>
								</div>
							)}
							<p class="entradilla">
								<span class="comilla" aria-hidden="true">“</span>{b.entradilla}
							</p>
							<p class="cuerpo">
								{b.resto}<span class="comilla" aria-hidden="true">”</span>
							</p>
						</section>
						{destacados[i] && (
							<p class="destacado">
								<span class="mascara">
									<span class="contenido">{destacados[i]}</span>
								</span>
							</p>
						)}
					</>
				))
			}
		</div>
		<Trayectoria />
		<LlamadaContacto />
	</main>
	<Footer actual="estudio" />
</Base>

<script>
	// Preguntas y destacados suben desde su máscara al entrar en pantalla. Solo se
	// esconden si este script arranca: sin JS se ven directamente.
	const entrevista = document.querySelector<HTMLElement>('[data-entrevista]');
	const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (entrevista && !sinMovimiento && 'IntersectionObserver' in window) {
		entrevista.classList.add('preparado');
		const observador = new IntersectionObserver(
			(entradas) => {
				entradas.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('visible');
						observador.unobserve(e.target);
					}
				});
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		entrevista.querySelectorAll('.mascara').forEach((m) => observador.observe(m));
	}
</script>

<style>
	/* Retícula de la web: columnas en 96 · 434 · 744 · 1044 px, hasta 1344 px
	   (cuatro pistas con 24 px entre ellas). */
	.entrevista {
		padding: 201px 6.667vw 0;
	}

	.bloque,
	.destacado {
		display: grid;
		grid-template-columns: 21.806vw 19.861vw 19.167vw 1fr;
		column-gap: 1.667vw;
	}

	.bloque {
		row-gap: 48px;
		align-items: start;
	}

	.bloque + .bloque,
	.destacado + .bloque {
		margin-top: var(--aire);
	}

	h2,
	p {
		margin: 0;
	}

	/* Escalas: Llamada o manifiesto (pregunta) / entradilla / Lectura. */
	.pregunta {
		font-weight: var(--peso-regular);
		font-size: var(--llamada);
		line-height: var(--llamada-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	.pregunta.grande,
	.destacado {
		font-weight: var(--peso-regular);
		font-size: var(--manifiesto);
		line-height: var(--manifiesto-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	.entradilla {
		font-weight: var(--peso-regular);
		font-size: var(--respuesta);
		line-height: var(--respuesta-alto);
	}

	.cuerpo {
		font-weight: var(--peso-regular);
		font-size: var(--lectura);
		line-height: var(--lectura-alto);
	}

	.comilla {
		color: var(--color-secundario);
	}

	/* Marca "(p)": pequeña y en gris, colgada en el margen a la altura de la primera
	   línea de la pregunta. */
	.pregunta .contenido {
		position: relative;
	}

	.marca {
		position: absolute;
		right: calc(100% + 12px);
		top: 0.2em;
		color: var(--color-secundario);
		font-size: var(--nav-lateral);
		line-height: var(--nav-lateral-alto);
		letter-spacing: 0;
	}

	/* Destacados: frases literales de la entrevista, como respiro entre bloques. */
	.destacado {
		margin-top: 160px;
	}

	.destacado .mascara {
		grid-column: 2 / 5;
	}

	/* 1 · pregunta a lo ancho; foto pequeña, entradilla y resto en fila. */
	.v1 .pregunta { grid-column: 1 / 5; grid-row: 1; }
	.v1 .foto { grid-column: 1; grid-row: 2; }
	.v1 .entradilla { grid-column: 2; grid-row: 2; }
	.v1 .cuerpo { grid-column: 3; grid-row: 2; }

	/* 2 · foto apaisada grande a la derecha; texto a la izquierda. */
	.v2 .pregunta { grid-column: 1 / 3; grid-row: 1; }
	.v2 .foto { grid-column: 3 / 5; grid-row: 1 / 3; }
	.v2 .entradilla { grid-column: 1; grid-row: 2; }
	.v2 .cuerpo { grid-column: 2; grid-row: 2; }

	/* 3 · solo tipografía, desplazado a la segunda columna. */
	.v3 .pregunta { grid-column: 2 / 5; grid-row: 1; }
	.v3 .entradilla { grid-column: 2; grid-row: 2; }
	.v3 .cuerpo { grid-column: 3; grid-row: 2; }

	/* 4 · foto alta a la izquierda; texto a la derecha. */
	.v4 .foto { grid-column: 1 / 3; grid-row: 1 / 3; width: 35.556vw; }
	.v4 .pregunta { grid-column: 3 / 5; grid-row: 1; }
	.v4 .entradilla { grid-column: 3; grid-row: 2; }
	.v4 .cuerpo { grid-column: 4; grid-row: 2; }

	/* 5 · pregunta a lo ancho; foto apaisada a la derecha del texto. */
	.v5 .pregunta { grid-column: 1 / 4; grid-row: 1; }
	.v5 .entradilla { grid-column: 1; grid-row: 2; }
	.v5 .cuerpo { grid-column: 2; grid-row: 2; }
	.v5 .foto { grid-column: 3 / 5; grid-row: 2; }

	/* 6 · foto pequeña a la derecha; texto en las columnas centrales. */
	.v6 .pregunta { grid-column: 2 / 4; grid-row: 1; }
	.v6 .entradilla { grid-column: 2; grid-row: 2; }
	.v6 .cuerpo { grid-column: 3; grid-row: 2; }
	.v6 .foto { grid-column: 4; grid-row: 1 / 3; }

	/* 7 · cierre: pregunta a tamaño manifiesto y foto apaisada a la izquierda. */
	.v7 .pregunta { grid-column: 1 / 5; grid-row: 1; }
	.v7 .foto { grid-column: 1 / 3; grid-row: 2; }
	.v7 .entradilla { grid-column: 3; grid-row: 2; }
	.v7 .cuerpo { grid-column: 4; grid-row: 2; }

	/* Con una foto que ocupa dos filas, el alto sobrante va a la última: el texto queda
	   junto arriba en vez de repartirse. */
	.v2,
	.v4,
	.v6 {
		grid-template-rows: auto 1fr;
	}

	/* Máscara de las animaciones: recorta solo arriba y abajo (la "(p)" colgada no se
	   corta). */
	.mascara {
		display: block;
		clip-path: inset(0 -100vw);
		padding-bottom: 0.15em;
		margin-bottom: -0.15em;
	}

	.contenido {
		display: block;
		transition: transform 1.2s var(--ease);
	}

	.preparado .contenido {
		transform: translateY(110%);
	}

	.preparado .visible .contenido {
		transform: none;
	}

	/* Anchos intermedios (tabletas): dos columnas iguales. La pregunta a lo ancho; debajo,
	   la foto en una columna y el texto en la otra, alternando el lado. Con cuatro
	   columnas el texto quedaría demasiado estrecho. */
	@media (min-width: 810px) and (max-width: 1100px) {
		.bloque,
		.destacado {
			grid-template-columns: 1fr 1fr;
		}

		.entrevista .bloque {
			grid-template-rows: auto auto 1fr;
			row-gap: 32px;
		}

		.entrevista .bloque .pregunta { grid-column: 1 / -1; grid-row: 1; }
		.entrevista .bloque .foto { grid-column: 1; grid-row: 2 / 4; width: auto; }
		.entrevista .bloque .entradilla { grid-column: 2; grid-row: 2; }
		.entrevista .bloque .cuerpo { grid-column: 2; grid-row: 3; }

		/* Fotos apaisadas: a la derecha, con el texto a la izquierda. */
		.entrevista .v2 .foto,
		.entrevista .v5 .foto,
		.entrevista .v7 .foto { grid-column: 2; }
		.entrevista .v2 .entradilla,
		.entrevista .v5 .entradilla,
		.entrevista .v7 .entradilla,
		.entrevista .v2 .cuerpo,
		.entrevista .v5 .cuerpo,
		.entrevista .v7 .cuerpo { grid-column: 1; }

		/* Bloque sin foto: entradilla y resto, una al lado del otro. */
		.entrevista .v3 .entradilla { grid-column: 1; grid-row: 2; }
		.entrevista .v3 .cuerpo { grid-column: 2; grid-row: 2; }

		.destacado .mascara {
			grid-column: 1 / -1;
		}
	}

	/* Móvil: una columna (foto, pregunta, entradilla, resto), con los tres tamaños. */
	@media (max-width: 809px) {
		.entrevista {
			padding: 120px var(--margen) 0;
		}

		.bloque,
		.destacado {
			display: flex;
			flex-direction: column;
			gap: 24px;
		}

		.bloque + .bloque,
		.destacado + .bloque {
			margin-top: 120px;
		}

		.destacado {
			margin-top: 96px;
		}

		.bloque .foto {
			order: -1;
		}

		.v4 .foto {
			width: 100%;
		}

		/* Sin margen para colgarla: la "(p)" va delante, arriba de la primera línea. */
		.marca {
			position: static;
			margin-right: 0.4em;
			vertical-align: top;
		}
	}
</style>
