---
// Página de un idioma: solo indica qué vista mostrar. El contenido está en src/vistas/
// y los textos en src/i18n/ (ver docs/definicion.md, Idiomas).
import Vista from '../../vistas/Obra.astro';
import { identificadores } from '../../data/obras';

export async function getStaticPaths() {
	return (await identificadores()).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<Vista slug={slug} />
