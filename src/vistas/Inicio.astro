---
import Base from '../layouts/Base.astro';
import Carga from '../components/Carga.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Video from '../components/home/Video.astro';
import Manifiesto from '../components/home/Manifiesto.astro';
import Obras from '../components/home/Obras.astro';
import Autor from '../components/home/Autor.astro';
import LlamadaContacto from '../components/LlamadaContacto.astro';
import { video } from '../data/videos';
import { deLaMarca } from '../data/estructurados';
import { usar } from '../i18n';

const { t, r } = usar(Astro);

// Vídeos de la home: por nombre de archivo (src/data/videos.ts). Sin archivo = bloque provisional.
const videoPrincipal = video('principal');
const videoObras = video('obras');
---

<Base datos={deLaMarca(t.seo.inicio.descripcion, t.seo.profesion, r.autor)}>
	<Carga />
	<Nav claro />
	<main>
		<h1 class="solo-lectores">{t.home.titulo}</h1>
		<Video nombre={t.home.videoPrincipal} {...videoPrincipal} />
		<Manifiesto />
		<Obras {...videoObras} />
		<Autor />
		<LlamadaContacto />
	</main>
	<Footer />
</Base>
