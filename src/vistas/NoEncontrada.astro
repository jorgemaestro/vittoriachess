---
// Vista de la página no encontrada, en el idioma de la página — ver docs/definicion.md
// (Páginas: Página no encontrada). Misma columna que Contacto (434 px, desde 201 px), con
// la barra y el pie de la web.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EnlaceGuia from '../components/EnlaceGuia.astro';
import { usar } from '../i18n';

const { t, r } = usar(Astro);
const textos = t.noEncontrada;
---

<Base title={`${textos.titulo} — ${t.sufijoTitulo}`} noindex>
	<Nav />
	<main class="no-encontrada">
		<h1 class="palabra">{textos.palabra}</h1>
		<p class="frase">{textos.frase}</p>
		<p class="accion"><EnlaceGuia href={r.inicio} lado="izquierda">{textos.volver}</EnlaceGuia></p>
	</main>
	<Footer />
</Base>

<style>
	/* Columna a 434 px (30,139 vw), 572 px de ancho (39,722 vw), desde 201 px. */
	.no-encontrada {
		width: 39.722vw;
		min-height: 50vh;
		padding: 201px 0 0 30.139vw;
	}

	.palabra {
		margin: 0;
		font-weight: var(--peso-medio);
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
	}

	.frase {
		margin: 16px 0 0;
		font-weight: var(--peso-regular);
		font-size: var(--llamada);
		line-height: var(--llamada-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	.accion {
		margin: 48px 0 0;
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
	}

	@media (max-width: 809px) {
		.no-encontrada {
			width: auto;
			padding: 120px var(--margen) 0;
		}
	}
</style>
