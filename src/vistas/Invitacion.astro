---
// Invitación privada de la inauguración — ver docs/invitacion.md.
// Página fuera de la navegación pública: sin menú ni pie de la web, fuera de Google y del mapa
// del sitio. Arriba, la marca, el selector ES / EN y un enlace a la home que reemplaza el
// historial (no se vuelve con Atrás). Secciones: portada, carta, objetivo, cómo funciona,
// por qué este momento, objetivo (con su destino), cómo funciona, la ventana comercial hasta
// el 31/12, obras reales, ejemplo de 1.000 € y éxito extraordinario (desplegables), preguntas,
// calendario, cercanía, cómo participar (inactivo hasta revisar el acuerdo) y regalo en bronce.
// Las cifras de las tablas salen de la función de src/data/participacion.ts.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Enlace from '../components/Enlace.astro';
import EnlaceGuia from '../components/EnlaceGuia.astro';
import Foto from '../components/Foto.astro';
import { calcular } from '../data/participacion';
import { cargarObras } from '../data/obras';
import { invitacion, claveInvitacion, precios, facturacionEstimada, escalones } from '../data/invitacion';
import { exposicion } from '../data/exposicion';
import { usar, rutas } from '../i18n';

const { t, idioma } = usar(Astro);
const x = t.invitacion;
const en = idioma === 'en';
const direccion = { es: `/invitacion/${claveInvitacion}`, en: `/en/invitation/${claveInvitacion}` };

// Formatos: 8.000 € / €8,000; −50 % / −50%.
const euros = (n: number) => {
	const cifra = Math.abs(n).toLocaleString(en ? 'en-GB' : 'de-DE', { maximumFractionDigits: 2 });
	const signo = n < 0 ? '−' : '';
	return en ? `${signo}€${cifra}` : `${signo}${cifra} €`;
};
const porcentaje = (n: number) => {
	const cifra = Math.abs(n).toLocaleString(en ? 'en-GB' : 'de-DE', { maximumFractionDigits: 1 });
	const signo = n < 0 ? '−' : n > 0 ? '+' : '';
	return en ? `${signo}${cifra}%` : `${signo}${cifra} %`;
};

// Estado de la financiación (solo lo verificado).
const { objetivo, recibido } = invitacion;
const alcanzado = recibido >= objetivo;
const avance = Math.min(100, (100 * recibido) / objetivo);
const fechaActualizado = new Date(`${invitacion.actualizado}T12:00:00`).toLocaleDateString(
	en ? 'en-GB' : 'es-ES',
	{ day: 'numeric', month: 'long', year: 'numeric' },
);


// Obras reales para «Obras concebidas para perdurar»: como mucho tres, solo las que tienen
// foto y nombre en su ficha (sin precios ni catálogo inventado).
const obrasReales = (await cargarObras(idioma, t.obras.sinDatos))
	.filter((o) => o.conFotos && o.completa.nombre)
	.slice(0, 3);
// Foto del puente «Por qué este momento»: la de la primera obra real.
const fotoMomento = obrasReales[0];

// «Rentabilidad según las ventas»: escalones de facturación (IVA incluido). Neto = precio sin
// IVA × margen prudente (60 %). Con el objetivo reunido y utilizado; aportación de 1.000 €.
const escenarios = escalones.map(({ facturacion: fact, coste }, i) => {
	const r = calcular({ F: invitacion.objetivo, U: invitacion.objetivo, A: 1000, N: Math.max(0, fact / 1.21 - coste) });
	return [`${euros(fact)} (${x.ejemplo.filas[i]})`, euros(Math.round(r.T / 5) * 5), porcentaje(Math.round(r.ROI))];
});

// Save the date: inauguración, jueves 10 de diciembre, 20:00–23:00 (Madrid).
const g = x.guardar;
const lugarEvento = en ? 'Malasaña, Madrid' : 'Malasaña, Madrid';
const googleCalendar =
	'https://calendar.google.com/calendar/render?action=TEMPLATE' +
	`&text=${encodeURIComponent(g.evento)}&dates=20261210T190000Z/20261210T220000Z` +
	`&details=${encodeURIComponent(g.detalle)}&location=${encodeURIComponent(lugarEvento)}&ctz=Europe/Madrid`;
const ics = [
	'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Vittoria Chess//ES', 'BEGIN:VEVENT',
	'UID:inauguracion-2026@vittoriachess.com', 'DTSTAMP:20261110T000000Z',
	'DTSTART:20261210T190000Z', 'DTEND:20261210T220000Z',
	`SUMMARY:${g.evento}`, `DESCRIPTION:${g.detalle}`, `LOCATION:${lugarEvento}`,
	'END:VEVENT', 'END:VCALENDAR',
].join('\r\n');
const icsEnlace = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;

const p = x.participar;
const mailtoDuda = `mailto:${invitacion.correo}?subject=${encodeURIComponent(p.asuntoDuda)}`;
const mailtoParticipar = `mailto:${invitacion.correo}?subject=${encodeURIComponent(invitacion.asuntoParticipar)}&body=${encodeURIComponent(p.cuerpoCorreo)}`;
---

<Base title={x.tituloSeo} noindex sinReferente>
	<header class="cabecera">
		<Logo enlace={false} />
		<p class="confidencial">{x.confidencial}</p>
		<nav class="lado" aria-label={en ? 'Language' : 'Idioma'}>
			<span class="idiomas">
				<Enlace href={direccion.es} activo={!en} hreflang="es">ES</Enlace>
				<span aria-hidden="true">/</span>
				<Enlace href={direccion.en} activo={en} hreflang="en">EN</Enlace>
			</span>
			<Enlace href={rutas[idioma].inicio} data-salida>{x.irWeb}</Enlace>
		</nav>
	</header>

	<main class="invitacion">
		<!-- 01 · Portada -->
		<section class="portada">
			<div class="imagen">
				<Foto
					nombre="invitacion/portada"
					alt={`[${t.pendiente}: ${x.imagenPortada}]`}
					proporcion={1277 / 732}
					sizes="(max-width: 809px) calc(100vw - 40px), 86.667vw"
				/>
			</div>
			<div class="columna">
				<p class="etiqueta">{x.etiqueta}</p>
				<h1 class="titulo">{x.titulo}</h1>
				<p class="subtitulo">{x.subtitulo}</p>
				<p class="dato">{x.fecha}</p>
				<p class="dato">{x.lugar}</p>
				<p class="dato">{x.apertura}</p>
				<p class="regalo-portada">{x.regaloPortada}</p>
				<p class="accion"><a class="boton" href="#participar">{x.botonParticipar}</a></p>
			</div>
		</section>

		<!-- 02 · Carta -->
		<section class="bloque" id="carta">
			<div class="columna carta">
				{x.carta.map((parrafo) => <p set:html={parrafo} />)}
				<div class="cuenta" data-cuenta data-inicio={exposicion.inicio} hidden>
					<p class="etiqueta">{x.faltan}</p>
					<p class="cifras-cuenta">
						{t.exposicion.unidades.map((unidad, i) => (
							<span class="bloque-cuenta">
								<span class="numero-cuenta" data-unidad={i}>00</span>
								<span class="unidad-cuenta">{unidad}</span>
							</span>
						))}
					</p>
				</div>
				<p class="firma">{x.firma}<br /><span class="gris">{x.marca}</span></p>
			</div>
		</section>

		<!-- Regalo en bronce (aportaciones superiores a 500 €), tras la carta para darle importancia -->
		<section class="bloque regalo">
			<div class="imagen-regalo">
				<Foto
					nombre="invitacion/regalo"
					alt={`[${t.pendiente}: ${x.regalo.imagen}]`}
					proporcion={4 / 5}
					sizes="(max-width: 809px) calc(100vw - 40px), 35.556vw"
				/>
			</div>
			<div class="texto-regalo">
				<p class="etiqueta">{x.regalo.condicion}</p>
				<h2 class="titulo-regalo">{x.regalo.titulo}</h2>
				{x.regalo.texto.map((parrafo) => <p>{parrafo}</p>)}
				<p class="firma">{x.firma}</p>
			</div>
		</section>

		{/* «El comienzo de una nueva etapa»: oculto por ahora (decisión de Jorge, 09/11/2026). */}

		<!-- Save the date -->
		<section class="bloque">
			<div class="columna">
				<p class="etiqueta">{g.etiqueta}</p>
				<p class="titulo-bloque">{g.titulo}</p>
				<p class="texto">{g.texto}</p>
				<p class="acciones-calendario">
					<a class="boton" href={googleCalendar} target="_blank" rel="noopener noreferrer">{g.google}</a>
					<Enlace href={icsEnlace} download="vittoria-chess-inauguracion.ics">{g.otros}</Enlace>
				</p>

				<p class="etiqueta compartir-etiqueta">{x.compartir.etiqueta}</p>
				<p class="texto">{x.compartir.texto}</p>
				<p class="acciones-calendario" data-compartir data-ruta={rutas[idioma].obras} data-mensaje={x.compartir.mensaje}>
					<a class="boton" href={`https://wa.me/?text=${encodeURIComponent(`${x.compartir.mensaje} https://vittoriachess.pages.dev${rutas[idioma].obras}`)}`} target="_blank" rel="noopener noreferrer" data-whatsapp>{x.compartir.whatsapp}</a>
					<button class="enlace-boton" type="button" data-nativo hidden>{x.compartir.otras}</button>
					<button class="enlace-boton" type="button" data-copiar-enlace data-copiado={x.compartir.copiado}>{x.compartir.copiar}</button>
				</p>
			</div>
		</section>

		<!-- 03 · Objetivo -->
		<section class="bloque">
			<h2 class="seccion">{x.objetivo.titulo}</h2>
			<div class="columna">
				<p class="cifra-grande">{euros(objetivo)}</p>
				<div class="progreso" role="img" aria-label={`${porcentaje(avance).replace('+', '')}`}>
					<span style={`width: ${avance}%`}></span>
				</div>
				<dl class="cifras">
					<div><dt>{x.objetivo.recibido}</dt><dd>{euros(recibido)} · {porcentaje(avance).replace('+', '')}</dd></div>
					<div><dt>{x.objetivo.pendiente}</dt><dd>{euros(Math.max(0, objetivo - recibido))}</dd></div>
					<div><dt>{x.objetivo.actualizado}</dt><dd>{fechaActualizado}</dd></div>
				</dl>
				{alcanzado && <p class="aviso">{x.objetivo.alcanzado}</p>}
				<p class="nota">{x.objetivo.nota}</p>

			</div>
		</section>

		<!-- 04 · Cómo funciona -->
		<section class="bloque">
			<h2 class="seccion">{x.funcionamiento.titulo}</h2>
			<div class="columna">
				<ol class="pasos">
					{
						x.funcionamiento.pasos.map(([titulo, texto], i) => (
							<li>
								<span class="numero">{String(i + 1).padStart(2, '0')}</span>
								<p class="paso-titulo">{titulo}</p>
								<p set:html={texto} />
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- La ventana comercial hasta el 31/12 (sin cronómetro) -->
		<section class="bloque">
			<div class="columna">
				<p class="titulo-bloque">{x.ventana.titulo}</p>
				<ol class="hitos">
					{x.ventana.hitos.map(([cuando, que]) => <li><span class="cuando">{cuando}</span><span class="que">{que}</span></li>)}
				</ol>
				<p class="texto" set:html={x.ventana.texto} />
			</div>
		</section>

		<!-- La obra: hasta tres obras reales, con su nombre exacto -->
		{
			obrasReales.length > 0 && (
				<section class="bloque">
					<div class="columna">
						<p class="titulo-bloque">{x.obra.titulo}</p>
						<p class="texto">{x.obra.texto}</p>
						<p class="texto discreto">{x.momento.discreto}</p>
					</div>
					<ul class="obras-reales">
						{obrasReales.map((o) => (
							<li>
								<Foto nombre={o.fotos[0]} alt={o.nombre} proporcion={3 / 4} sizes="(max-width: 809px) calc(100vw - 40px), 27.778vw" />
								<p class="pie-obra">{o.nombre}<br /><span class="gris">{o.tipo}</span></p>
							</li>
						))}
					</ul>
					<div class="columna">
						<p class="etiqueta expuestas">{x.obra.expuestas}</p>
						<ul class="lista-obras">
							{precios.map((pr) => <li>{pr.obra}{pr.unidades ? ` (${pr.unidades})` : ''}</li>)}
						</ul>
						<p class="etiqueta facturacion">{x.obra.facturacion}</p>
						<p class="cifra-grande">{euros(facturacionEstimada)} <span class="estimados">{x.obra.estimados}</span></p>
						<p class="texto sorpresa">{x.obra.sorpresa}</p>
						<p class="nota">{x.obra.notaPrecios}</p>
					</div>
				</section>
			)
		}

		<!-- Qué puedes recibir: según las obras vendidas -->
		<section class="bloque">
			<h2 class="seccion">{x.ejemplo.titulo}</h2>
			<div class="columna">
				<table>
					<thead><tr>{x.ejemplo.columnas.map((c) => <th scope="col">{c}</th>)}</tr></thead>
					<tbody>{escenarios.map((fila) => <tr><th scope="row">{fila[0]}</th><td>{fila[1]}</td><td>{fila[2]}</td></tr>)}</tbody>
				</table>
				<p class="nota">{x.ejemplo.nota}</p>
				<p class="accion"><a class="boton" href="#participar">{x.botonParticipar}</a></p>
			</div>
		</section>

		<!-- 08 · Preguntas frecuentes -->
		<section class="bloque">
			<h2 class="seccion">{x.preguntas.titulo}</h2>
			<div class="columna">
				{
					x.preguntas.lista.map(([pregunta, respuesta]) => (
						<details class="pregunta">
							<summary data-ver={x.ver} data-cerrar={x.cerrar}>{pregunta}</summary>
							<p>{respuesta}</p>
						</details>
					))
				}
			</div>
		</section>

		<!-- 09 · Transparencia y calendario -->
		<section class="bloque">
			<h2 class="seccion">{x.calendario.titulo}</h2>
			<div class="columna">
				<dl class="calendario">
					{x.calendario.fases.map(([cuando, que]) => <div><dt>{cuando}</dt><dd>{que}</dd></div>)}
				</dl>
			</div>
		</section>

		<!-- Cercanía: un agradecimiento que va más allá del retorno -->
		<section class="bloque">
			<div class="columna">
				<p class="titulo-bloque">{x.cercania.titulo}</p>
				<p class="texto">{x.cercania.texto}</p>
			</div>
		</section>

		<!-- 10 · Cómo participar -->
		<section class="bloque" id="participar">
			<h2 class="seccion">{p.titulo}</h2>
			<div class="columna">
				{!invitacion.aportacionesAbiertas && <p class="estado">{p.estado}</p>}
				{!invitacion.aportacionesAbiertas && <p class="texto">{p.aviso}</p>}
				{
					invitacion.aportacionesAbiertas && invitacion.iban ? (
						<ol class="pasos">
							<li>
								<span class="numero">01</span>
								<p class="paso-titulo">{p.pasos[0][0]}</p>
								<p>{p.pasos[0][1]}</p>
								<dl class="cuenta">
									<div><dt>{p.titular}</dt><dd>{invitacion.titular}</dd></div>
									<div>
										<dt>{p.iban}</dt>
										<dd>
											{invitacion.iban}{' '}
											<button class="copiar" type="button" data-copiar={invitacion.iban.replace(/\s/g, '')} data-copiado={p.copiado}>{p.copiarIban}</button>
										</dd>
									</div>
									<div>
										<dt>{p.concepto}</dt>
										<dd>
											{invitacion.concepto}{' '}
											<button class="copiar" type="button" data-copiar={invitacion.concepto} data-copiado={p.copiado}>{p.copiarConcepto}</button>
										</dd>
									</div>
								</dl>
							</li>
							<li>
								<span class="numero">02</span>
								<p class="paso-titulo">{p.pasos[1][0]}</p>
								<p>{p.pasos[1][1]}</p>
							</li>
							<li>
								<span class="numero">03</span>
								<p class="paso-titulo">{p.pasos[2][0]}</p>
								<p>{p.pasos[2][1]}</p>
							</li>
						</ol>
					) : (
				<ol class="pasos">
					{
						p.pasos.map(([titulo, texto], i) => (
							<li>
								<span class="numero">{String(i + 1).padStart(2, '0')}</span>
								<p class="paso-titulo">{titulo}</p>
								<p>{texto}</p>
							</li>
						))
					}
				</ol>
					)
				}
				<p class="acciones">
					<Enlace href={mailtoDuda}>{p.duda}</Enlace>
				</p>
				{invitacion.aportacionesAbiertas && <p class="nota">{p.nota}</p>}
			</div>
		</section>

		<p class="gracias">{x.gracias}</p>
		<p class="visitar" data-salida><EnlaceGuia href={rutas[idioma].inicio} lado="derecha">{x.visitar}</EnlaceGuia></p>
	</main>

	<footer class="pie">
		<p>{x.pie}</p>
		<p><Enlace href={rutas[idioma].inicio} data-salida>{x.irWeb}</Enlace></p>
	</footer>
</Base>

<script>
	// Cuenta atrás hasta la inauguración (como en Obras). Sin JavaScript no se muestra.
	const cuenta = document.querySelector<HTMLElement>('[data-cuenta]');
	if (cuenta) {
		const inicio = Date.parse(cuenta.dataset.inicio ?? '');
		const numeros = [...cuenta.querySelectorAll<HTMLElement>('[data-unidad]')];
		const pintar = () => {
			let s = Math.max(0, Math.floor((inicio - Date.now()) / 1000));
			const partes = [Math.floor(s / 86400), Math.floor((s %= 86400) / 3600), Math.floor((s %= 3600) / 60), s % 60];
			partes.forEach((valor, i) => numeros[i] && (numeros[i].textContent = String(valor).padStart(2, '0')));
			return s > 0 || partes.some((v) => v > 0);
		};
		if (pintar()) {
			cuenta.hidden = false;
			const reloj = setInterval(() => !pintar() && clearInterval(reloj), 1000);
		}
	}

	// Compartir la página pública de Obras (nunca esta invitación). La dirección se forma con el
	// dominio desde el que se ve la página, para que valga en la provisional y en la definitiva.
	const compartir = document.querySelector<HTMLElement>('[data-compartir]');
	if (compartir) {
		const url = `${location.origin}${compartir.dataset.ruta}`;
		const mensaje = compartir.dataset.mensaje ?? '';
		const whatsapp = compartir.querySelector<HTMLAnchorElement>('[data-whatsapp]');
		if (whatsapp) whatsapp.href = `https://wa.me/?text=${encodeURIComponent(`${mensaje} ${url}`)}`;
		// Instagram no permite compartir desde la web: se usa el menú del propio móvil, que lo incluye.
		const nativo = compartir.querySelector<HTMLButtonElement>('[data-nativo]');
		if (nativo && 'share' in navigator) {
			nativo.hidden = false;
			nativo.addEventListener('click', () => navigator.share({ title: 'Vittoria Chess', text: mensaje, url }).catch(() => {}));
		}
		const copiar = compartir.querySelector<HTMLButtonElement>('[data-copiar-enlace]');
		copiar?.addEventListener('click', async () => {
			const original = copiar.textContent;
			try {
				await navigator.clipboard.writeText(url);
				copiar.textContent = copiar.dataset.copiado ?? original;
				setTimeout(() => (copiar.textContent = original), 2000);
			} catch {
				/* Sin permiso del navegador: no se copia. */
			}
		});
	}

	// Salida a la home reemplazando el historial: Atrás no vuelve a la invitación.
	document.querySelectorAll<HTMLAnchorElement>('a[data-salida], [data-salida] a').forEach((enlace) => {
		enlace.addEventListener('click', (e) => {
			e.preventDefault();
			window.location.replace(enlace.href);
		});
	});

	// Botones de copiar (solo existen cuando se abran las aportaciones).
	document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
		const original = boton.textContent;
		boton.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(boton.dataset.copiar ?? '');
				boton.textContent = boton.dataset.copiado ?? original;
				setTimeout(() => (boton.textContent = original), 2000);
			} catch {
				/* Sin permiso del navegador: el dato sigue a la vista para copiarlo a mano. */
			}
		});
	});
</script>

<style>
	p,
	h1,
	h2,
	dl,
	dd,
	ol {
		margin: 0;
	}

	/* Cabecera propia: marca a la izquierda; idioma y salida a la derecha. */
	.cabecera {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: var(--margen);
	}

	.lado {
		display: flex;
		gap: 40px;
		font-size: var(--nav-lateral);
		line-height: var(--nav-lateral-alto);
	}

	.idiomas {
		display: flex;
		gap: 4px;
	}

	/* Columna de lectura a 434 px (30,139 vw), 572 px de ancho (39,722 vw). */
	.columna {
		width: 39.722vw;
		margin-left: 30.139vw;
	}

	.bloque {
		margin-top: 160px;
	}

	/* Título de sección a 96 px, como TRAYECTORIA; el contenido, en la columna. */
	/* Tres niveles: títulos a 40 px (como los de bloque), intro y carta a 24 px, detalle a 16 px.
	   Todos los títulos, en la columna de lectura. */
	.seccion {
		margin: 0 0 24px 30.139vw;
		font-weight: var(--peso-regular);
		font-size: var(--llamada);
		line-height: var(--llamada-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

