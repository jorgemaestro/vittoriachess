---
// Vista de Las piezas, en el idioma de la página — ver docs/definicion.md
// (Páginas: Las piezas). Fondo claro, como el resto de la web (en prueba).
// Seis figuras 3:4, del peón al rey, de anchos distintos y en posiciones irregulares
// (src/data/piezas.ts); dos llegan al borde de la pantalla. Pie: el nombre a 24 / 32 px,
// 12 px bajo la imagen. Llamada a contacto al final.
// Móvil: una columna, 80 px entre piezas.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Foto from '../components/Foto.astro';
import LlamadaContacto from '../components/LlamadaContacto.astro';
import { piezas, composicion } from '../data/piezas';
import { usar } from '../i18n';

const { t } = usar(Astro);

const vw = (px: number) => `${((px / 1440) * 100).toFixed(3)}vw`;
const alto = (ancho: number) => (ancho * 4) / 3;
const fondo = Math.max(...piezas.map((p) => composicion[p].arriba + alto(composicion[p].ancho)));
---

<Base title={t.seo.piezas.titulo} description={t.seo.piezas.descripcion} imagen="piezas/peon">
	<Nav actual="piezas" />
	<main>
		<h1 class="solo-lectores">{t.piezas.titulo}</h1>
		<ul class="piezas" style={`--alto: ${vw(fondo)}`}>
			{
				piezas.map((p) => {
					const c = composicion[p];
					return (
					<li
						class:list={['pieza', { 'al-borde': c.izquierda === 0, 'al-borde-derecho': c.izquierda + c.ancho === 1440 }]}
						style={`--x: ${vw(c.izquierda)}; --y: ${vw(c.arriba)}; --ancho: ${vw(c.ancho)}`}
					>
						<Foto
							nombre={`piezas/${p}`}
							alt={t.piezas.nombres[p]}
							proporcion={600 / 800}
							sizes={`(max-width: 809px) calc(100vw - 40px), ${vw(c.ancho)}`}
						/>
						<p class="nombre">{t.piezas.nombres[p]}</p>
					</li>
					);
				})
			}
		</ul>
		<LlamadaContacto />
	</main>
	<Footer />
</Base>

<style>
	/* Lienzo de 1440: el alto cubre la última pieza y su nombre (12 px + 32 px). */
	.piezas {
		position: relative;
		height: calc(var(--alto) + 44px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pieza {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--ancho);
	}

	/* La imagen que llega al borde derecho se ancla a él: así termina justo en el borde
	   aunque el navegador reserve sitio para la barra de desplazamiento. */
	.al-borde-derecho {
		left: auto;
		right: 0;
	}

	/* En la imagen pegada al borde izquierdo, el nombre respeta el margen. */
	.al-borde .nombre {
		margin-left: var(--margen);
	}

	.nombre {
		margin: 12px 0 0;
		font-weight: var(--peso-regular);
		font-size: var(--respuesta);
		line-height: var(--respuesta-alto);
	}

	@media (max-width: 809px) {
		.piezas {
			display: flex;
			flex-direction: column;
			gap: 80px;
			height: auto;
			padding: 120px var(--margen) 0;
		}

		.pieza {
			position: static;
			width: auto;
		}

		.al-borde .nombre {
			margin-left: 0;
		}
	}
</style>
