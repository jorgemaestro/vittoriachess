---
// Vista de Las piezas, en el idioma de la página — ver docs/definicion.md
// (Páginas: Las piezas). Página en tono oscuro.
// Seis figuras de 600 × 800, del peón al rey, alternando derecha (744 px) e izquierda
// (96 px) y empezando por la derecha; la primera a 201 px y 560 px de paso. Pie: el
// nombre en estilo Llamada, 12 px bajo la imagen. Llamada a contacto al final.
// Móvil: una columna, 80 px entre piezas.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Foto from '../components/Foto.astro';
import LlamadaContacto from '../components/LlamadaContacto.astro';
import { piezas } from '../data/piezas';
import { usar } from '../i18n';

const { t } = usar(Astro);

const vw = (px: number) => `${((px / 1440) * 100).toFixed(3)}vw`;
const ARRIBA = 201;
const PASO = 560;
const fondo = ARRIBA + (piezas.length - 1) * PASO + 800;
---

<Base title={`${t.piezas.titulo} — ${t.sufijoTitulo}`} tono="oscuro">
	<Nav actual="piezas" />
	<main>
		<h1 class="solo-lectores">{t.piezas.titulo}</h1>
		<ul class="piezas" style={`--alto: ${vw(fondo)}`}>
			{
				piezas.map((p, i) => (
					<li
						class="pieza"
						style={`--x: ${vw(i % 2 === 0 ? 744 : 96)}; --y: ${vw(ARRIBA + i * PASO)}`}
					>
						<Foto
							nombre={`piezas/${p}`}
							alt={t.piezas.nombres[p]}
							proporcion={600 / 800}
							sizes="(max-width: 809px) calc(100vw - 40px), 41.667vw"
						/>
						<p class="nombre">{t.piezas.nombres[p]}</p>
					</li>
				))
			}
		</ul>
		<LlamadaContacto />
	</main>
	<Footer />
</Base>

<style>
	/* Lienzo de 1440: el alto cubre la última pieza y su nombre (12 px + 48 px). */
	.piezas {
		position: relative;
		height: calc(var(--alto) + 60px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pieza {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: 41.667vw; /* 600 px */
	}

	.nombre {
		margin: 12px 0 0;
		font-weight: var(--peso-regular);
		font-size: var(--llamada);
		line-height: var(--llamada-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	@media (max-width: 809px) {
		.piezas {
			display: flex;
			flex-direction: column;
			gap: 80px;
			height: auto;
			padding: 120px var(--margen) 0;
		}

		.pieza {
			position: static;
			width: auto;
		}
	}
</style>
