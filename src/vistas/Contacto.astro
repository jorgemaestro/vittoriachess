---
// Vista de Contacto, en el idioma de la página — ver docs/definicion.md (Páginas: Contacto).
// Columna a 434 px, 572 px de ancho, desde 201 px: palabra CONTACTO, frase en estilo
// Llamada, apunte en pequeño y formulario (campos sin caja, línea inferior de 1 px).
// ENVIAR con línea guía.
// El envío va a Web3Forms sin salir de la página; si falla, el formulario se queda con lo
// escrito y un aviso. Sin JavaScript se envía igualmente (página de confirmación de Web3Forms).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Enlace from '../components/Enlace.astro';
import EnlaceGuia from '../components/EnlaceGuia.astro';
import { cargarObras } from '../data/obras';
import { titular, formulario } from '../data/titular';
import { usar } from '../i18n';

const { t, r, idioma } = usar(Astro);
const c = t.contacto;

// Para empezar el mensaje con el nombre de la obra al llegar desde su página (?obra=slug).
const obras = await cargarObras(idioma, t.obras.sinDatos);
const consultas = Object.fromEntries(obras.map((o) => [o.slug, t.obras.mensajeConsulta(o.nombre)]));

const campos = [
	{ id: 'nombre', etiqueta: c.campos.nombre, tipo: 'text', autocompletar: 'given-name', obligatorio: true },
	{ id: 'apellidos', etiqueta: c.campos.apellidos, tipo: 'text', autocompletar: 'family-name', obligatorio: false },
	{ id: 'telefono', etiqueta: c.campos.telefono, tipo: 'tel', autocompletar: 'tel', obligatorio: false },
	{ id: 'email', etiqueta: c.campos.email, tipo: 'email', autocompletar: 'email', obligatorio: true },
];
---

<Base title={t.seo.contacto.titulo} description={t.seo.contacto.descripcion}>
	<Nav actual="contacto" />
	<main class="contacto">
		<h1 class="palabra">{c.palabra}</h1>
		<p class="frase">{c.frase}</p>
		<p class="apunte">{c.apunte}</p>

		<form
			class="formulario"
			action={formulario.destino}
			method="post"
			novalidate
			data-formulario
			data-consultas={JSON.stringify(consultas)}
			data-avisos={JSON.stringify(c.avisos)}
			data-asunto={c.asunto}
		>
			<input type="hidden" name="access_key" value={formulario.clave} />
			<input type="hidden" name="subject" value={`${c.asunto} ${titular.web}`} />
			<input type="hidden" name="from_name" value="Vittoria Chess" />
			<input type="hidden" name="idioma" value={idioma.toUpperCase()} />
			<!-- Solo para el envío sin JavaScript (Fase 10: página propia de confirmación). -->
			<input type="hidden" name="redirect" value="https://web3forms.com/success" />
			<!-- Campo trampa: invisible para las personas; si un robot lo marca, no se envía. -->
			<input class="trampa" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
			{
				campos.map((campo) => (
					<div class="campo">
						<label for={campo.id}>{campo.etiqueta}</label>
						<input
							id={campo.id}
							name={campo.id}
							type={campo.tipo}
							autocomplete={campo.autocompletar}
							required={campo.obligatorio}
							aria-describedby={`aviso-${campo.id}`}
						/>
						<p class="aviso" id={`aviso-${campo.id}`} aria-live="polite"></p>
					</div>
				))
			}
			<div class="campo">
				<label for="mensaje">{c.campos.mensaje}</label>
				<textarea id="mensaje" name="mensaje" rows="4" required aria-describedby="aviso-mensaje"
				></textarea>
				<p class="aviso" id="aviso-mensaje" aria-live="polite"></p>
			</div>

			<div class="envio">
				<EnlaceGuia lado="izquierda">{c.enviar}</EnlaceGuia>
				<p class="privacidad">
					{c.aceptas} <Enlace href={r.privacidad}>{c.politica}</Enlace>
				</p>
				<p class="aviso fallo" role="alert" hidden data-fallo>
					{c.fallo} <Enlace href={`mailto:${titular.email}`}>{titular.email.toUpperCase()}</Enlace>
				</p>
			</div>
		</form>

		<!-- Tras enviar, la página se queda solo con esto. -->
		<div class="recibido" tabindex="-1" hidden data-recibido>
			<p class="frase">{c.gracias}</p>
			<p class="apunte">{c.recibido}</p>
			<p class="volver"><EnlaceGuia href={r.inicio} lado="izquierda">{t.noEncontrada.volver}</EnlaceGuia></p>
		</div>
	</main>
	<Footer actual="contacto" />
</Base>

<script>
	const formulario = document.querySelector<HTMLFormElement>('[data-formulario]');
	const recibido = document.querySelector<HTMLElement>('[data-recibido]');
	const fallo = document.querySelector<HTMLElement>('[data-fallo]');

	// Los textos de los avisos vienen en el idioma de la página (data-avisos).
	const textos: Record<string, string> = JSON.parse(formulario?.dataset.avisos ?? '{}');
	const avisos: Record<string, (valor: string, campo: HTMLInputElement) => string> = {
		nombre: (v) => (v ? '' : textos.nombre),
		email: (v, campo) => (!v ? textos.email : campo.validity.typeMismatch ? textos.emailInvalido : ''),
		mensaje: (v) => (v ? '' : textos.mensaje),
	};

	const comprobar = (campo: HTMLInputElement) => {
		const regla = avisos[campo.name];
		if (!regla) return true;
		const texto = regla(campo.value.trim(), campo);
		document.getElementById(`aviso-${campo.name}`)!.textContent = texto;
		if (texto) campo.setAttribute('aria-invalid', 'true');
		else campo.removeAttribute('aria-invalid');
		return !texto;
	};

	if (formulario && recibido) {
		const campos = [...formulario.querySelectorAll<HTMLInputElement>('.campo input, .campo textarea')];
		const boton = formulario.querySelector<HTMLButtonElement>('button[type="submit"]');

		// Al llegar desde la página de una obra (?obra=slug), el mensaje empieza con su nombre.
		const obra = new URLSearchParams(location.search).get('obra');
		const consulta = obra && JSON.parse(formulario.dataset.consultas ?? '{}')[obra];
		const mensaje = formulario.querySelector<HTMLTextAreaElement>('#mensaje');
		if (consulta && mensaje && !mensaje.value) {
			mensaje.value = `${consulta}\n\n`;
		}

		// Al corregir un campo con aviso, el aviso se quita en cuanto vuelve a estar bien.
		campos.forEach((campo) =>
			campo.addEventListener('input', () => {
				if (campo.hasAttribute('aria-invalid')) comprobar(campo);
			}),
		);

		formulario.addEventListener('submit', async (e) => {
			e.preventDefault();
			const errores = campos.filter((campo) => !comprobar(campo));
			if (errores.length) {
				errores[0].focus();
				return;
			}
			// Envío a Web3Forms sin salir de la página. El asunto lleva el nombre del visitante.
			const datos = Object.fromEntries(new FormData(formulario)) as Record<string, string>;
			delete datos.redirect;
			datos.subject = `${formulario.dataset.asunto} ${`${datos.nombre} ${datos.apellidos}`.trim()}`;
			if (boton) boton.disabled = true;
			if (fallo) fallo.hidden = true;
			try {
				const respuesta = await fetch(formulario.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(datos),
				});
				const resultado = await respuesta.json();
				if (!respuesta.ok || !resultado.success) throw new Error(resultado.message);
				recibido.parentElement?.classList.add('enviado');
				recibido.hidden = false;
				scrollTo(0, 0);
				// La línea guía de VOLVER se mide ahora que ya está en pantalla.
				dispatchEvent(new Event('resize'));
				recibido.focus({ preventScroll: true });
			} catch {
				// Lo escrito se conserva; se avisa y se ofrece el email.
				if (fallo) fallo.hidden = false;
			} finally {
				if (boton) boton.disabled = false;
			}
		});
	}
</script>

<style>
	/* Columna a 434 px (30,139 vw), 572 px de ancho (39,722 vw), desde 201 px. */
	.contacto {
		width: 39.722vw;
		padding: 201px 0 0 30.139vw;
	}

	.palabra {
		margin: 0;
		font-weight: var(--peso-medio);
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
	}

	.frase {
		margin: 16px 0 0;
		font-weight: var(--peso-regular);
		font-size: var(--llamada);
		line-height: var(--llamada-alto);
		letter-spacing: var(--manifiesto-espaciado);
	}

	/* Segunda frase, con menor jerarquía. */
	.apunte {
		margin: 16px 0 0;
		color: var(--color-secundario);
		font-weight: var(--peso-regular);
		font-size: var(--lectura);
		line-height: var(--lectura-alto);
	}

	.formulario {
		display: flex;
		flex-direction: column;
		gap: 40px;
		margin-top: 80px;
	}

	.formulario[hidden] {
		display: none;
	}

	label {
		display: block;
		color: var(--color-secundario);
		font-size: var(--pie-foto);
		line-height: var(--pie-foto-alto);
	}

	.campo:focus-within label {
		color: var(--color-tinta);
	}

	/* Campos sin caja: solo una línea inferior de 1 px. */
	input,
	textarea {
		display: block;
		width: 100%;
		box-sizing: border-box;
		margin: 4px 0 0;
		padding: 0 0 6px;
		border: 0;
		border-bottom: var(--linea) solid currentColor;
		border-radius: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: var(--respuesta);
		line-height: var(--respuesta-alto);
		outline: none;
	}

	/* Mientras se escribe, la línea engrosa a --linea-foco (borde: nítido en cualquier
	   pantalla). El relleno inferior se reduce lo mismo para que el texto no se mueva. */
	input:focus,
	textarea:focus {
		border-bottom-width: var(--linea-foco);
		padding-bottom: calc(6px - (var(--linea-foco) - var(--linea)));
	}

	textarea {
		resize: vertical;
		min-height: calc(4 * var(--respuesta-alto));
	}

	/* Sin el fondo de color que pone el navegador al autocompletar. */
	input:-webkit-autofill {
		-webkit-box-shadow: 0 0 0 100px var(--color-fondo) inset;
		-webkit-text-fill-color: var(--color-tinta);
	}

	.aviso {
		margin: 6px 0 0;
		font-size: var(--pie-foto);
		line-height: var(--pie-foto-alto);
	}

	.aviso:empty,
	.aviso[hidden] {
		display: none;
	}

	.fallo {
		margin-top: 16px;
	}

	.trampa {
		display: none;
	}

	.envio {
		margin-top: 0; /* 40 px de separación + el alto de línea del botón = 48 px bajo el campo */
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
	}

	.privacidad {
		margin: 16px 0 0;
		color: var(--color-secundario);
		font-size: var(--pie-foto);
		line-height: var(--pie-foto-alto);
	}

	/* Tras enviar: la página se queda vacía, solo con el agradecimiento, y ocupa al menos
	   la pantalla para que el pie no suba. */
	.contacto.enviado {
		min-height: calc(100svh - 201px);
	}

	.contacto.enviado > :not(.recibido) {
		display: none;
	}

	.recibido {
		outline: none;
	}

	.recibido .frase {
		margin-top: 0;
	}

	.volver {
		margin: 48px 0 0;
		font-size: var(--nav-central);
		line-height: var(--nav-central-alto);
	}

	@media (max-width: 809px) {
		.contacto {
			width: auto;
			padding: 120px var(--margen) 0;
		}

		.contacto.enviado {
			min-height: calc(100svh - 120px);
		}
	}
</style>
